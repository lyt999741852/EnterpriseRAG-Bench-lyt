# EnterpriseRAG-Bench Environment Variables
# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit real keys.

# === LLM for Answer Generation + Evaluation ===
# Pick one of the options below:

# Option A: Cerebras (free tier, recommended for testing)
# Sign up: https://cloud.cerebras.ai -> API Keys -> create key
# Free: 1M tokens/day, 30 RPM, no credit card
# Models: llama3.3-70b, llama3.1-70b, llama3.1-8b
# ⚠️ Free tier context limit: 8K tokens
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Option B: Groq (free tier)
# Sign up: https://console.groq.com -> API Keys -> create key
# Free: 30 RPM, 1,000 req/day, no credit card
GROQ_API_KEY=your-groq-api-key-here

# Option C: DeepSeek (paid, cheap — ~¥1 for 500 questions)
# Sign up: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Option D: internal OpenAI-compatible Qwen endpoint
# Use the value required by the internal gateway; some local gateways accept EMPTY.
LARK_API_KEY=your-internal-api-key-here
